{
  "$description": "ClassAI design tokens: single source of truth for web and Android. Edit here, then run `node design/build-tokens.mjs`. Structure follows the W3C Design Tokens draft ($value, $type, $description, {references}).",

  "color": {
    "$type": "color",
    "neutral": {
      "$description": "Garúa: cool grey with a hint of blue, after Lima's overcast sky. Chrome is built only from this scale; hue is reserved for data and state.",
      "0":   { "$value": "#ffffff" },
      "25":  { "$value": "#fafbfb" },
      "50":  { "$value": "#f6f7f8" },
      "100": { "$value": "#eef0f2" },
      "150": { "$value": "#e1e4e8" },
      "200": { "$value": "#cdd2d8" },
      "300": { "$value": "#b2b9c1" },
      "400": { "$value": "#9aa2ab" },
      "500": { "$value": "#687079" },
      "600": { "$value": "#4a525c" },
      "700": { "$value": "#313943" },
      "750": { "$value": "#232a32" },
      "800": { "$value": "#181d23" },
      "850": { "$value": "#12161b" },
      "900": { "$value": "#0c0f13" }
    }
  },

  "theme": {
    "light": {
      "bg": {
        "$type": "color",
        "page":     { "$value": "{color.neutral.50}" },
        "surface":  { "$value": "{color.neutral.0}" },
        "raised":   { "$value": "{color.neutral.0}" },
        "sunken":   { "$value": "#f0f2f4" },
        "hover":    { "$value": "#eef0f2", "$description": "Ghost wash under hovered rows and buttons" },
        "selected": { "$value": "#e6e9ed" },
        "inverse":  { "$value": "#15191e" }
      },
      "border": {
        "$type": "color",
        "subtle":  { "$value": "#eceef1" },
        "default": { "$value": "{color.neutral.150}" },
        "strong":  { "$value": "{color.neutral.200}" },
        "focus":   { "$value": "#2f6fdb" }
      },
      "text": {
        "$type": "color",
        "primary":   { "$value": "#15191e" },
        "secondary": { "$value": "{color.neutral.600}" },
        "muted":     { "$value": "#646c75", "$description": "Axis labels, captions. AA on surface and page." },
        "faint":     { "$value": "{color.neutral.400}", "$description": "Placeholders and disabled only — never information." },
        "inverse":   { "$value": "#ffffff" },
        "link":      { "$value": "#2459b8" }
      },
      "brand": {
        "$type": "color",
        "ink":      { "$value": "#15191e", "$description": "Primary actions and the logotype. The brand is ink, not a hue." },
        "on-ink":   { "$value": "#ffffff" },
        "air-from": { "$value": "#2a78d6", "$description": "Logo ring gradient start (air)" },
        "air-to":   { "$value": "#1baf7a", "$description": "Logo ring gradient end (comfort)" }
      },
      "state": {
        "$type": "color",
        "$description": "Comfort state language. Always rendered with icon + label, never color alone.",
        "ok":      { "solid": { "$value": "#1f9d55" }, "text": { "$value": "#137240" }, "subtle": { "$value": "#e9f6ef" }, "border": { "$value": "#bfe5cf" } },
        "regular": { "solid": { "$value": "#e0a00b" }, "text": { "$value": "#8a5a05" }, "subtle": { "$value": "#fdf5e1" }, "border": { "$value": "#f1d9a0" } },
        "alert":   { "solid": { "$value": "#dc3f3f" }, "text": { "$value": "#b42727" }, "subtle": { "$value": "#fdecec" }, "border": { "$value": "#f5c4c4" } },
        "offline": { "solid": { "$value": "{color.neutral.400}" }, "text": { "$value": "{color.neutral.600}" }, "subtle": { "$value": "#eef0f2" }, "border": { "$value": "{color.neutral.200}" } }
      },
      "intent": {
        "$type": "color",
        "success": { "$value": "{theme.light.state.ok.text}" },
        "warning": { "$value": "{theme.light.state.regular.text}" },
        "danger":  { "$value": "{theme.light.state.alert.text}" },
        "info":    { "$value": "#2459b8" },
        "info-subtle": { "$value": "#eaf1fd" }
      },
      "metric": {
        "$type": "color",
        "$description": "Per-metric identity hues (validated: adjacent CVD ΔE ≥ 24.7, normal-vision ΔE ≥ 33.6). Never co-plotted on one axis; always paired with the metric icon + label.",
        "temp":     { "$value": "#eb6834" },
        "rh":       { "$value": "#2a78d6" },
        "lux":      { "$value": "#eda100" },
        "noise":    { "$value": "#4a3aa7" },
        "presence": { "$value": "#1baf7a" },
        "comfort":  { "$value": "#15191e" }
      },
      "chart": {
        "$type": "color",
        "grid":      { "$value": "#eef0f2" },
        "axis":      { "$value": "{color.neutral.200}" },
        "band":      { "$value": "#1f9d5514", "$description": "Target-range fill (ok.solid @ 8%)" },
        "band-edge": { "$value": "#1f9d5559" },
        "out":       { "$value": "#dc3f3f12", "$description": "Out-of-range period wash" },
        "crosshair": { "$value": "{color.neutral.300}" },
        "compare":   { "$value": "{color.neutral.400}", "$description": "Comparison series: neutral, dashed" }
      }
    },

    "dark": {
      "bg": {
        "$type": "color",
        "page":     { "$value": "{color.neutral.900}" },
        "surface":  { "$value": "{color.neutral.850}" },
        "raised":   { "$value": "{color.neutral.800}" },
        "sunken":   { "$value": "#0f1317" },
        "hover":    { "$value": "#1b2027" },
        "selected": { "$value": "#222831" },
        "inverse":  { "$value": "#edf0f3" }
      },
      "border": {
        "$type": "color",
        "subtle":  { "$value": "#1a1f26" },
        "default": { "$value": "{color.neutral.750}" },
        "strong":  { "$value": "{color.neutral.700}" },
        "focus":   { "$value": "#6a9ef5" }
      },
      "text": {
        "$type": "color",
        "primary":   { "$value": "#edf0f3" },
        "secondary": { "$value": "#b0b8c1" },
        "muted":     { "$value": "#8a939d" },
        "faint":     { "$value": "#5f6872" },
        "inverse":   { "$value": "#12161b" },
        "link":      { "$value": "#8ab4f8" }
      },
      "brand": {
        "$type": "color",
        "ink":      { "$value": "#edf0f3" },
        "on-ink":   { "$value": "#12161b" },
        "air-from": { "$value": "#3987e5" },
        "air-to":   { "$value": "#199e70" }
      },
      "state": {
        "$type": "color",
        "ok":      { "solid": { "$value": "#3cc27a" }, "text": { "$value": "#6ad99b" }, "subtle": { "$value": "#13261c" }, "border": { "$value": "#1e4a31" } },
        "regular": { "solid": { "$value": "#f0b43a" }, "text": { "$value": "#f5c862" }, "subtle": { "$value": "#2a220f" }, "border": { "$value": "#4d3c14" } },
        "alert":   { "solid": { "$value": "#f06464" }, "text": { "$value": "#ff8f8f" }, "subtle": { "$value": "#2c1416" }, "border": { "$value": "#5a2328" } },
        "offline": { "solid": { "$value": "#5f6872" }, "text": { "$value": "#b0b8c1" }, "subtle": { "$value": "#1b2027" }, "border": { "$value": "#313943" } }
      },
      "intent": {
        "$type": "color",
        "success": { "$value": "{theme.dark.state.ok.text}" },
        "warning": { "$value": "{theme.dark.state.regular.text}" },
        "danger":  { "$value": "{theme.dark.state.alert.text}" },
        "info":    { "$value": "#8ab4f8" },
        "info-subtle": { "$value": "#132036" }
      },
      "metric": {
        "$type": "color",
        "temp":     { "$value": "#d95926" },
        "rh":       { "$value": "#3987e5" },
        "lux":      { "$value": "#c98500" },
        "noise":    { "$value": "#9085e9" },
        "presence": { "$value": "#199e70" },
        "comfort":  { "$value": "#edf0f3" }
      },
      "chart": {
        "$type": "color",
        "grid":      { "$value": "#1b2027" },
        "axis":      { "$value": "{color.neutral.700}" },
        "band":      { "$value": "#3cc27a17" },
        "band-edge": { "$value": "#3cc27a59" },
        "out":       { "$value": "#f0646414" },
        "crosshair": { "$value": "#4a525c" },
        "compare":   { "$value": "#6b747e" }
      }
    }
  },

  "font": {
    "$type": "fontFamily",
    "sans": { "$value": "'Geist Variable', 'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif", "$description": "Everything, including numbers (tabular figures on)." },
    "mono": { "$value": "'Geist Mono Variable', 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace", "$description": "Identifiers only: session ids, student codes, credential tokens, keyboard keys." }
  },

  "type": {
    "$description": "Size / line-height / weight / tracking. Base 14 px (dense product UI).",
    "display": { "size": { "$value": "40px" }, "line": { "$value": "44px" }, "weight": { "$value": 560 }, "tracking": { "$value": "-0.025em" } },
    "title":   { "size": { "$value": "22px" }, "line": { "$value": "28px" }, "weight": { "$value": 600 }, "tracking": { "$value": "-0.018em" } },
    "heading": { "size": { "$value": "16px" }, "line": { "$value": "22px" }, "weight": { "$value": 600 }, "tracking": { "$value": "-0.01em" } },
    "label":   { "size": { "$value": "13px" }, "line": { "$value": "18px" }, "weight": { "$value": 520 }, "tracking": { "$value": "-0.003em" } },
    "body":    { "size": { "$value": "14px" }, "line": { "$value": "20px" }, "weight": { "$value": 420 }, "tracking": { "$value": "-0.006em" } },
    "small":   { "size": { "$value": "13px" }, "line": { "$value": "18px" }, "weight": { "$value": 420 }, "tracking": { "$value": "0em" } },
    "caption": { "size": { "$value": "12px" }, "line": { "$value": "16px" }, "weight": { "$value": 460 }, "tracking": { "$value": "0.002em" } },
    "micro":   { "size": { "$value": "11px" }, "line": { "$value": "14px" }, "weight": { "$value": 500 }, "tracking": { "$value": "0.01em" } },
    "metric":  { "size": { "$value": "28px" }, "line": { "$value": "32px" }, "weight": { "$value": 520 }, "tracking": { "$value": "-0.03em" } },
    "hero":    { "size": { "$value": "56px" }, "line": { "$value": "56px" }, "weight": { "$value": 540 }, "tracking": { "$value": "-0.045em" } }
  },

  "space": {
    "$type": "dimension",
    "$description": "4 px base grid.",
    "0": { "$value": "0px" }, "0_5": { "$value": "2px" }, "1": { "$value": "4px" }, "1_5": { "$value": "6px" },
    "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" }, "5": { "$value": "20px" },
    "6": { "$value": "24px" }, "8": { "$value": "32px" }, "10": { "$value": "40px" }, "12": { "$value": "48px" }, "16": { "$value": "64px" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "Radius follows hierarchy: larger containers, larger radius. Never one radius for everything.",
    "xs": { "$value": "4px", "$description": "Chips inside tables, keyboard keys" },
    "sm": { "$value": "6px", "$description": "Badges, small buttons" },
    "md": { "$value": "8px", "$description": "Buttons, inputs, menu items" },
    "lg": { "$value": "12px", "$description": "Panels" },
    "xl": { "$value": "16px", "$description": "Dialogs, command palette" },
    "full": { "$value": "9999px" }
  },

  "border": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "focus": { "$value": "2px" },
    "focus-offset": { "$value": "2px" }
  },

  "shadow": {
    "$type": "shadow",
    "light": {
      "xs": { "$value": "0 1px 2px rgba(16,19,23,0.05)" },
      "sm": { "$value": "0 1px 2px rgba(16,19,23,0.04), 0 1px 3px rgba(16,19,23,0.06)" },
      "md": { "$value": "0 2px 4px -1px rgba(16,19,23,0.05), 0 6px 16px -4px rgba(16,19,23,0.10)" },
      "lg": { "$value": "0 4px 8px -2px rgba(16,19,23,0.06), 0 20px 48px -12px rgba(16,19,23,0.22)" }
    },
    "dark": {
      "xs": { "$value": "0 1px 2px rgba(0,0,0,0.4)" },
      "sm": { "$value": "0 1px 2px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.03)" },
      "md": { "$value": "0 6px 16px -4px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.04)" },
      "lg": { "$value": "0 24px 56px -12px rgba(0,0,0,0.7), inset 0 1px 0 rgba(255,255,255,0.05)" }
    }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "80ms",  "$description": "Hover, press" },
      "fast":    { "$value": "140ms", "$description": "Tooltips, chips, toggles" },
      "base":    { "$value": "220ms", "$description": "Panels, menus, page transitions" },
      "slow":    { "$value": "360ms", "$description": "Dialogs, list reordering" },
      "chart":   { "$value": "900ms", "$description": "Line draw-in on mount" },
      "update":  { "$value": "480ms", "$description": "Chart domain glide on a new data point" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard":   { "$value": [0.2, 0, 0, 1],    "$description": "Default for everything that moves" },
      "enter":      { "$value": [0, 0, 0.2, 1],    "$description": "Things arriving" },
      "exit":       { "$value": [0.4, 0, 1, 1],    "$description": "Things leaving (shorter than enter)" },
      "emphasized": { "$value": [0.3, 0, 0, 1.0],  "$description": "Gauge sweep, draw-in" }
    },
    "spring": {
      "$type": "spring",
      "snappy": { "$value": { "stiffness": 520, "damping": 38, "mass": 1 }, "$description": "Layout shifts, list inserts" },
      "gentle": { "$value": { "stiffness": 220, "damping": 28, "mass": 1 }, "$description": "Panels, popovers" },
      "gauge":  { "$value": { "stiffness": 70,  "damping": 18, "mass": 1 }, "$description": "Comfort gauge and animated counters" }
    }
  },

  "z": {
    "$type": "number",
    "base": { "$value": 0 }, "sticky": { "$value": 10 }, "sidebar": { "$value": 20 }, "header": { "$value": 30 },
    "dropdown": { "$value": 40 }, "overlay": { "$value": 50 }, "modal": { "$value": 60 }, "toast": { "$value": 70 }, "tooltip": { "$value": 80 }
  },

  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" }, "md": { "$value": "768px" }, "lg": { "$value": "1024px" }, "xl": { "$value": "1280px" }, "2xl": { "$value": "1536px" }
  },

  "icon": {
    "$description": "Lucide icon set (lucide-react / Material-compatible SVGs on Android). One stroke weight everywhere.",
    "stroke": { "$type": "number", "$value": 1.75 },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "14px", "$description": "Inside chips and table cells" },
      "sm": { "$value": "16px", "$description": "Default: buttons, nav, inputs" },
      "md": { "$value": "20px", "$description": "Metric headers, empty states inline" },
      "lg": { "$value": "24px", "$description": "Feature icons" }
    },
    "map": {
      "$type": "other",
      "$value": {
        "temp": "thermometer", "rh": "droplets", "lux": "sun", "noise": "audio-lines", "presence": "person-standing",
        "comfort": "gauge", "fan": "fan", "ok": "circle-check", "regular": "circle-alert", "alert": "triangle-alert",
        "offline": "wifi-off", "online": "radio", "card": "credit-card", "phone": "smartphone-nfc",
        "feedback_ok": "thumbs-up", "feedback_hot": "flame", "feedback_cold": "snowflake", "feedback_noisy": "volume-2", "feedback_dark": "sun-dim"
      }
    }
  }
}
