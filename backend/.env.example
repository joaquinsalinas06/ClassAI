# Docker en Linux usa network_mode: host; 127.0.0.1 apunta al Mosquitto del host.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Tópico legado MLX90614; los tópicos classai/v1/+/{telemetry,events,status} se suscriben siempre.
MQTT_TOPIC=MLX90614/temperature
MQTT_CLIENT_ID=MLX90614-backend-server
MQTT_DASHBOARD_CLIENT_ID=MLX90614-dashboard-server
# Suscriptor de /live en la API (se le agrega el pid).
MQTT_API_CLIENT_ID=classai-api-live

# Déjalos vacíos solo si Mosquitto no requiere autenticación.
MQTT_USERNAME=
MQTT_PASSWORD=

# Ruta dentro del contenedor. Se persiste en ./data del host.
DATABASE_PATH=data/mlx90614.db

# Streamlit escucha solo en localhost del servidor Linux por defecto.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501

# API FastAPI: localhost por defecto; las consultas sin zona usan esta zona local.
API_HOST=127.0.0.1
API_PORT=8000
LOCAL_TIMEZONE=America/Lima

# Clave para POST /credentials y /credentials/{id}/revoke (header X-API-Key). Sin ella, esos endpoints responden 503.
ADMIN_API_KEY=
