<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight: claro/oscuro según el sistema; tokens semánticos generados en values/values-night -->
    <style name="Theme.ClassAI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ds_brand_ink</item>
        <item name="colorOnPrimary">@color/ds_brand_on_ink</item>
        <item name="colorPrimaryContainer">@color/ds_bg_selected</item>
        <item name="colorOnPrimaryContainer">@color/ds_text_primary</item>
        <item name="colorSecondary">@color/ds_brand_ink</item>
        <item name="colorOnSecondary">@color/ds_brand_on_ink</item>
        <item name="colorSecondaryContainer">@color/ds_state_ok_subtle</item>
        <item name="colorOnSecondaryContainer">@color/ds_state_ok_text</item>
        <item name="colorTertiary">@color/ds_brand_ink</item>
        <item name="colorOnTertiary">@color/ds_brand_on_ink</item>
        <item name="colorTertiaryContainer">@color/ds_bg_selected</item>
        <item name="colorOnTertiaryContainer">@color/ds_text_primary</item>
        <item name="colorSurfaceInverse">@color/ds_bg_inverse</item>
        <item name="colorOnSurfaceInverse">@color/ds_text_inverse</item>
        <item name="android:colorBackground">@color/ds_bg_page</item>
        <item name="colorSurface">@color/ds_bg_surface</item>
        <item name="colorOnSurface">@color/ds_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/ds_text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/ds_bg_surface</item>
        <item name="colorSurfaceContainerLow">@color/ds_bg_sunken</item>
        <item name="colorSurfaceContainer">@color/ds_bg_surface</item>
        <item name="colorSurfaceContainerHigh">@color/ds_bg_raised</item>
        <item name="colorSurfaceContainerHighest">@color/ds_bg_selected</item>
        <item name="colorOutline">@color/ds_border_strong</item>
        <item name="colorError">@color/ds_state_alert_text</item>
        <item name="colorOnError">@color/ds_state_alert_subtle</item>
        <item name="colorErrorContainer">@color/ds_state_alert_subtle</item>
        <item name="colorOnErrorContainer">@color/ds_state_alert_text</item>
        <item name="textAppearanceBodyLarge">@style/ClassAI.Text.Body</item>
        <item name="textAppearanceBodyMedium">@style/ClassAI.Text.Body</item>
        <item name="textAppearanceBodySmall">@style/ClassAI.Text.Caption</item>
        <item name="textAppearanceTitleMedium">@style/ClassAI.Text.Heading</item>
        <item name="textAppearanceTitleLarge">@style/ClassAI.Text.Title</item>
        <item name="colorOutlineVariant">@color/ds_border_default</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.ClassAI.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.ClassAI.Large</item>
    </style>

    <style name="Shape.ClassAI.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/ds_radius_md</item>
    </style>

    <style name="Shape.ClassAI.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/ds_radius_xl</item>
    </style>

    <style name="ClassAI.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/ds_radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/ds_radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/ds_radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/ds_radius_md</item>
        <item name="startIconTint">?attr/colorPrimary</item>
        <item name="android:layout_marginTop">@dimen/ds_space_3</item>
    </style>

    <!-- El par ink/on-ink invierte juntos en modo oscuro. -->
    <style name="ClassAI.CardText" parent="">
        <item name="android:textColor">@color/ds_brand_on_ink</item>
    </style>
    <style name="ClassAI.Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/ds_text_body_size</item>
        <item name="lineHeight">@dimen/ds_text_body_line</item>
    </style>
    <style name="ClassAI.Text.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/ds_text_caption_size</item>
        <item name="lineHeight">@dimen/ds_text_caption_line</item>
    </style>
    <style name="ClassAI.Text.Heading" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/ds_text_heading_size</item>
        <item name="lineHeight">@dimen/ds_text_heading_line</item>
    </style>
    <style name="ClassAI.Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/ds_text_title_size</item>
        <item name="lineHeight">@dimen/ds_text_title_line</item>
    </style>
</resources>
