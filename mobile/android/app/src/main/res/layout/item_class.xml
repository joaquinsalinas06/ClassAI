<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ds_space_3"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/ds_space_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.classai.mobile.PulseDotView
            android:id="@+id/live"
            android:layout_width="18dp"
            android:layout_height="18dp" />

        <TextView
            android:id="@+id/liveText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_1_5"
            android:layout_weight="1"
            android:fontFamily="@font/geist_medium"
            android:text="@string/live"
            android:textColor="@color/ds_state_alert_text"
            android:textSize="@dimen/ds_text_caption_size" />

        <TextView
            android:id="@+id/elapsed"
            style="@style/ClassAI.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/ds_text_caption_size" />
    </LinearLayout>

    <TextView
        android:id="@+id/course"
        style="@style/ClassAI.Serif.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_2"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="26sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/ds_space_1"
            android:fontFamily="@font/geist_medium"
            android:gravity="center_vertical"
            android:textColor="@color/ds_text_secondary"
            android:textSize="@dimen/ds_text_body_size"
            app:drawableStartCompat="@drawable/ic_room"
            app:drawableTint="@color/ds_text_muted" />

        <TextView
            android:id="@+id/since"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_4"
            android:drawablePadding="@dimen/ds_space_1"
            android:fontFamily="@font/geist_medium"
            android:gravity="center_vertical"
            android:textColor="@color/ds_text_secondary"
            android:textSize="@dimen/ds_text_body_size"
            app:drawableStartCompat="@drawable/ic_schedule"
            app:drawableTint="@color/ds_text_muted" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="@dimen/ds_space_3"
        android:background="@color/ds_border_subtle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/status"
            style="@style/ClassAI.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/comfortDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:id="@+id/comfort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_1_5"
            android:fontFamily="@font/geist_medium"
            android:textColor="@color/ds_text_secondary"
            android:textSize="@dimen/ds_text_label_size" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/ds_space_1"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron"
            app:tint="@color/ds_text_muted" />
    </LinearLayout>
</LinearLayout>
