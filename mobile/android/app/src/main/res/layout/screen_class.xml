<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ds_space_5"
            android:paddingTop="@dimen/ds_space_4"
            android:paddingBottom="@dimen/app_nav_clearance">

            <!-- Sin clase abierta -->
            <LinearLayout
                android:id="@+id/noClass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_10"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <com.classai.mobile.SignalView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/noClassTitle"
                    style="@style/ClassAI.Title.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_5"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:gravity="center"
                    android:text="@string/classes_empty"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical">

                <!-- Encabezado del aula -->
                <LinearLayout
                    android:id="@+id/head"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/liveBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_live"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="12dp">

                            <com.classai.mobile.PulseDotView
                                android:id="@+id/liveDot"
                                android:layout_width="18dp"
                                android:layout_height="18dp" />

                            <TextView
                                android:id="@+id/liveText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/figtree_semibold"
                                android:text="@string/live"
                                android:textColor="@color/ds_state_alert_text"
                                android:textSize="@dimen/ds_text_caption_size" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/elapsed"
                            style="@style/ClassAI.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_3" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/course"
                        style="@style/ClassAI.Title.Display"
                        android:fontFamily="@font/figtree_bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_3"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/room"
                            style="@style/ClassAI.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:drawableStartCompat="@drawable/ic_room"
                            app:drawableTint="@color/ds_text_muted" />

                        <TextView
                            android:id="@+id/since"
                            style="@style/ClassAI.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_2"
                            app:drawableStartCompat="@drawable/ic_schedule"
                            app:drawableTint="@color/ds_text_muted" />

                        <TextView
                            android:id="@+id/present"
                            style="@style/ClassAI.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_2"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/ic_people"
                            app:drawableTint="@color/ds_text_muted" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_3"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_error"
                    android:padding="@dimen/ds_space_3"
                    android:textColor="@color/ds_state_alert_text"
                    android:textSize="@dimen/ds_text_body_size"
                    android:visibility="gone" />

                <!-- Estado de asistencia: una línea (la ilustración vive en Inicio) -->
                <LinearLayout
                    android:id="@+id/attended"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:background="@drawable/bg_ok_banner"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/ds_space_3"
                    android:paddingVertical="@dimen/ds_space_2">

                    <ImageView
                        android:id="@+id/attendedIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_success_solid"
                        android:importantForAccessibility="no"
                        android:padding="7dp"
                        android:src="@drawable/avd_check" />

                    <TextView
                        android:id="@+id/attendedText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_3"
                        android:layout_weight="1"
                        android:fontFamily="@font/figtree_semibold"
                        android:maxLines="2"
                        android:textColor="@color/ds_state_ok_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/attendedTime"
                        style="@style/ClassAI.Number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_2"
                        android:textColor="@color/ds_state_ok_text"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Carga -->
                <LinearLayout
                    android:id="@+id/loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.classai.mobile.ShimmerView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="@dimen/ds_space_5" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="@dimen/ds_space_3"
                        android:orientation="horizontal">

                        <com.classai.mobile.ShimmerView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <Space
                            android:layout_width="@dimen/ds_space_3"
                            android:layout_height="0dp" />

                        <com.classai.mobile.ShimmerView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Métricas del aula -->
                <LinearLayout
                    android:id="@+id/metrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/metricsTitle"
                        style="@style/ClassAI.Title.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8" />

                    <LinearLayout
                        android:id="@+id/comfortCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_3"
                        android:background="@drawable/bg_card"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_5">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="136dp"
                                android:layout_height="136dp">

                                <com.classai.mobile.GaugeView
                                    android:id="@+id/gauge"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/comfortValue"
                                        style="@style/ClassAI.Number"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/app_number_xl" />

                                    <TextView
                                        style="@style/ClassAI.Label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/of_100"
                                        android:textSize="@dimen/ds_text_caption_size" />
                                </LinearLayout>
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_4"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/ClassAI.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/comfort_now" />

                                <TextView
                                    android:id="@+id/comfortState"
                                    style="@style/ClassAI.Title.Title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp" />

                                <TextView
                                    android:id="@+id/comfortTrend"
                                    style="@style/ClassAI.Chip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ds_space_2"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/trendBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_4"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <com.classai.mobile.SparklineView
                                android:id="@+id/spark"
                                android:layout_width="match_parent"
                                android:layout_height="56dp" />

                            <TextView
                                android:id="@+id/trendCaption"
                                style="@style/ClassAI.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_1"
                                android:textSize="@dimen/ds_text_caption_size" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_3"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/tileTemp"
                            layout="@layout/item_tile" />

                        <Space
                            android:layout_width="@dimen/ds_space_3"
                            android:layout_height="0dp" />

                        <include
                            android:id="@+id/tileRh"
                            layout="@layout/item_tile" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_3"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/tileNoise"
                            layout="@layout/item_tile" />

                        <Space
                            android:layout_width="@dimen/ds_space_3"
                            android:layout_height="0dp" />

                        <include
                            android:id="@+id/tileLight"
                            layout="@layout/item_tile" />
                    </LinearLayout>

                    <!-- Movimiento, presentes y ventilador -->
                    <LinearLayout
                        android:id="@+id/presenceCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_3"
                        android:background="@drawable/bg_card"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_4">

                        <TextView
                            style="@style/ClassAI.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/presence_title" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_3"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/zoneEntrance"
                                style="@style/ClassAI.Zone">

                                <com.classai.mobile.PulseDotView
                                    android:id="@+id/entranceDot"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/ds_space_2"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/ClassAI.Label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/zone_entrance"
                                        android:textSize="@dimen/ds_text_caption_size" />

                                    <TextView
                                        android:id="@+id/entranceText"
                                        style="@style/ClassAI.ZoneValue" />
                                </LinearLayout>
                            </LinearLayout>

                            <Space
                                android:layout_width="@dimen/ds_space_3"
                                android:layout_height="0dp" />

                            <LinearLayout
                                android:id="@+id/zoneInterior"
                                style="@style/ClassAI.Zone">

                                <com.classai.mobile.PulseDotView
                                    android:id="@+id/interiorDot"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/ds_space_2"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/ClassAI.Label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/zone_interior"
                                        android:textSize="@dimen/ds_text_caption_size" />

                                    <TextView
                                        android:id="@+id/interiorText"
                                        style="@style/ClassAI.ZoneValue" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_3"
                            android:orientation="horizontal">

                            <LinearLayout style="@style/ClassAI.Zone">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:background="@drawable/bg_icon_soft"
                                    android:importantForAccessibility="no"
                                    android:padding="5dp"
                                    android:src="@drawable/ic_people"
                                    app:tint="@color/ds_text_secondary" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/ds_space_2"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/ClassAI.Label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/present_title"
                                        android:textSize="@dimen/ds_text_caption_size" />

                                    <TextView
                                        android:id="@+id/presentValue"
                                        style="@style/ClassAI.ZoneValue" />
                                </LinearLayout>
                            </LinearLayout>

                            <Space
                                android:layout_width="@dimen/ds_space_3"
                                android:layout_height="0dp" />

                            <LinearLayout style="@style/ClassAI.Zone">

                                <ImageView
                                    android:id="@+id/fanIcon"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:background="@drawable/bg_icon_soft"
                                    android:importantForAccessibility="no"
                                    android:padding="5dp"
                                    android:src="@drawable/ic_fan"
                                    app:tint="@color/ds_text_secondary" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/ds_space_2"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/ClassAI.Label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/fan_title"
                                        android:textSize="@dimen/ds_text_caption_size" />

                                    <TextView
                                        android:id="@+id/fanText"
                                        style="@style/ClassAI.ZoneValue" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/metricsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_5"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_4"
                    android:visibility="gone">

                    <com.classai.mobile.PulseDotView
                        android:id="@+id/waitDot"
                        android:layout_width="28dp"
                        android:layout_height="28dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_3"
                        android:layout_weight="1"
                        android:text="@string/metrics_empty"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="@dimen/ds_text_body_size" />
                </LinearLayout>

                <!-- Atajo al voto -->
                <LinearLayout
                    android:id="@+id/voteShortcut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_3"
                    android:background="@drawable/bg_vote_shortcut"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_4">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/voteShortcutTitle"
                            style="@style/ClassAI.Title.Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ds_app_on_mood" />

                        <TextView
                            android:id="@+id/voteShortcutBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/ds_app_on_mood_soft"
                            android:textSize="@dimen/ds_text_label_size" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_on_mood"
                        android:importantForAccessibility="no"
                        android:padding="6dp"
                        android:src="@drawable/ic_chevron"
                        app:tint="@color/ds_app_mood_ok_deep" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
