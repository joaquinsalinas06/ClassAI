<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen"
    android:background="@color/ds_bg_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:menu="@menu/card"
        app:title="@string/card_toolbar"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/cardScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_4">

                <!-- Carnet digital -->
                <com.classai.mobile.IdCardView
                    android:id="@+id/idCard"
                    android:layout_width="match_parent"
                    android:layout_height="216dp"
                    android:layout_marginHorizontal="@dimen/ds_space_1"
                    android:layout_marginTop="@dimen/ds_space_1"
                    android:focusable="true"
                    android:padding="@dimen/ds_space_5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_school"
                                app:tint="@color/ds_brand_on_ink" />

                            <TextView
                                style="@style/ClassAI.CardText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_2"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.06"
                                android:text="@string/card_brand"
                                android:textSize="@dimen/ds_text_label_size" />

                            <LinearLayout
                                android:id="@+id/chip"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_chip"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="10dp">

                                <ImageView
                                    android:id="@+id/chipIcon"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_check_circle"
                                    app:tint="@color/ds_brand_on_ink" />

                                <TextView
                                    android:id="@+id/chipText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/ds_space_1_5"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/ds_brand_on_ink"
                                    android:textSize="@dimen/ds_text_caption_size" />
                            </LinearLayout>
                        </LinearLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="84dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.classai.mobile.AvatarView
                                android:id="@+id/avatar"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:contentDescription="@string/cd_avatar" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/ClassAI.CardText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.75"
                                    android:letterSpacing="0.2"
                                    android:text="@string/card_student"
                                    android:textSize="@dimen/ds_text_micro_size" />

                                <TextView
                                    android:id="@+id/cardName"
                                    style="@style/ClassAI.CardText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="2"
                                    android:textSize="@dimen/ds_text_title_size" />

                                <TextView
                                    android:id="@+id/cardCode"
                                    style="@style/ClassAI.CardText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ds_space_0_5"
                                    android:alpha="0.85"
                                    android:fontFamily="monospace"
                                    android:letterSpacing="0.08"
                                    android:textSize="@dimen/ds_text_body_size" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <com.classai.mobile.WavesView
                        android:id="@+id/waves"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginBottom="-20dp"
                        android:layout_marginEnd="-20dp"
                         />

                    <ImageView
                        android:id="@+id/nfcIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="bottom|end"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_contactless"
                        app:tint="@color/ds_brand_on_ink" />
                </com.classai.mobile.IdCardView>

                <TextView
                    android:id="@+id/hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/ds_space_5"
                    android:accessibilityLiveRegion="polite"
                    android:drawablePadding="@dimen/ds_space_2"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retry"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:text="@string/action_retry"
                    android:visibility="gone"
                    app:icon="@drawable/ic_refresh" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nfcSettings"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:text="@string/action_nfc_settings"
                    android:visibility="gone"
                    app:icon="@drawable/ic_contactless" />

                <!-- Últimas lecturas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_6"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_history"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_2"
                        android:accessibilityHeading="true"
                        android:text="@string/reads_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Filled"
                    app:cardBackgroundColor="@color/ds_bg_surface"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/ds_border_default"
                    app:strokeWidth="1dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_3"
                    app:cardCornerRadius="@dimen/ds_radius_xl">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true">

                        <LinearLayout
                            android:id="@+id/reads"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/ds_space_1_5" />

                        <LinearLayout
                            android:id="@+id/empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="@dimen/ds_space_5">

                            <com.classai.mobile.SignalView
                                android:layout_width="240dp"
                                android:layout_height="136dp"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_3"
                                android:text="@string/reads_empty_title"
                                android:textAppearance="?attr/textAppearanceTitleSmall" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_1"
                                android:gravity="center"
                                android:text="@string/reads_empty_body"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Detalles técnicos (enrolamiento por el docente / depuración) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detailsToggle"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:text="@string/details_show"
                    app:icon="@drawable/ic_code" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/details"
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_1"
                    android:visibility="gone"
                    app:cardCornerRadius="@dimen/ds_radius_xl">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_4">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/details_token"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/token"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="monospace"
                                android:textIsSelectable="true"
                                android:textSize="@dimen/ds_text_label_size" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/copy"
                                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/action_copy"
                                app:icon="@drawable/ic_copy" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tech"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_3"
                            android:lineSpacingExtra="4dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/technicalNfcSettings"
                            style="@style/Widget.Material3.Button.TextButton.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_nfc_settings"
                            app:icon="@drawable/ic_tune" />

                        <TextView
                            android:id="@+id/log"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_3"
                            android:fontFamily="monospace"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/ds_text_micro_size" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
