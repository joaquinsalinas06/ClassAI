<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ds_space_5"
        android:paddingTop="@dimen/ds_space_4"
        android:paddingBottom="@dimen/app_nav_clearance">

        <LinearLayout
            android:id="@+id/noClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_10"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <com.classai.mobile.SignalView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/noClassTitle"
                style="@style/ClassAI.Title.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_5"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:gravity="center"
                android:text="@string/vote_no_class"
                android:textColor="@color/ds_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/course"
                style="@style/ClassAI.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="@dimen/ds_text_body_size" />

            <!-- Qué votar: una dimensión por sensor del aula -->
            <HorizontalScrollView
                android:id="@+id/dimsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_3"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/dims"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Tarjeta de ánimo: cambia de color y de Kirby según la opción -->
            <LinearLayout
                android:id="@+id/moodCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:background="@drawable/bg_hero"
                android:elevation="10dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/ds_space_5"
                android:paddingTop="@dimen/ds_space_6"
                android:paddingBottom="@dimen/ds_space_5">

                <TextView
                    android:id="@+id/question"
                    style="@style/ClassAI.Title.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/ds_app_on_mood"
                    android:textSize="28sp" />

                <com.classai.mobile.KirbyView
                    android:id="@+id/kirby"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginTop="@dimen/ds_space_5" />

                <!-- Selector deslizable -->
                <FrameLayout
                    android:id="@+id/selector"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="@dimen/ds_space_5">

                    <View
                        android:id="@+id/selectorThumb"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_mood_outline" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/optCold" style="@style/ClassAI.MoodOption" />
                        <TextView android:id="@+id/optOk" style="@style/ClassAI.MoodOption" android:text="@string/vote_ok" />
                        <TextView android:id="@+id/optHot" style="@style/ClassAI.MoodOption" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/moodCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:background="@drawable/bg_glass_box"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:padding="@dimen/ds_space_3"
                    android:textColor="@color/ds_app_on_mood"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/send"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:textColor="@color/ds_app_card_on"
                    app:backgroundTint="@color/ds_app_on_mood"
                    app:iconGravity="textStart"
                    app:iconTint="@color/ds_state_ok_solid" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingTop="@dimen/ds_space_4"
                android:paddingBottom="@dimen/ds_space_2"
                android:visibility="gone">

                <TextView
                    android:id="@+id/summaryTitle"
                    style="@style/ClassAI.Title.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/ds_space_4"
                    android:textSize="18sp" />

                <LinearLayout
                    android:id="@+id/summaryRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/footnote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:gravity="center"
                android:text="@string/vote_footnote"
                android:textColor="@color/ds_text_muted"
                android:textSize="@dimen/ds_text_caption_size" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
