<?xml version="1.0" encoding="utf-8"?>
<!-- Una Activity, dos pantallas (login / carnet) para animar la transición entre ambas -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <include android:id="@+id/login" layout="@layout/screen_login" />

    <include android:id="@+id/card" layout="@layout/screen_card" android:visibility="gone" />

    <!-- Momento estrella: check animado sobre un velo -->
    <FrameLayout
        android:id="@+id/successOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_bg_page"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/successContent"
            android:paddingHorizontal="@dimen/ds_space_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/successCheck"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:background="@drawable/bg_success_circle"
                android:contentDescription="@string/cd_success"
                android:elevation="12dp"
                android:padding="18dp"
                android:src="@drawable/avd_check"
                app:tint="@color/ds_state_ok_text" />

            <TextView
                android:id="@+id/successTitle"
                android:accessibilityLiveRegion="assertive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_6"
                android:fontFamily="sans-serif-black"
                android:text="@string/success_title"
                android:textColor="@color/ds_text_primary"
                android:textSize="@dimen/ds_text_metric_size" />

            <TextView
                android:id="@+id/successBody"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_1_5"
                android:text="@string/success_body"
                android:textColor="@color/ds_text_secondary"
                android:textSize="@dimen/ds_text_heading_size" />
        </LinearLayout>
        <com.classai.mobile.ConfettiView
            android:id="@+id/confetti"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
