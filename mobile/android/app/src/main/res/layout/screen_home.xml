<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg_page"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:menu="@menu/home"
        app:title="@string/app_name"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_4">

                <com.classai.mobile.IdCardView
                    android:id="@+id/idCard"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:clipToPadding="false"
                    android:layout_marginHorizontal="@dimen/ds_space_1"
                    android:layout_marginTop="@dimen/ds_space_1"
                    android:padding="@dimen/ds_space_5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_school"
                                app:tint="@color/ds_brand_on_ink" />

                            <TextView
                                style="@style/ClassAI.CardText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_2"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.06"
                                android:text="@string/card_brand"
                                android:textSize="@dimen/ds_text_label_size" />

                            <LinearLayout
                                android:id="@+id/chip"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_chip"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="10dp">

                                <ImageView
                                    android:id="@+id/chipIcon"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_check_circle"
                                    app:tint="@color/ds_brand_on_ink" />

                                <TextView
                                    android:id="@+id/chipText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/ds_space_1_5"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/ds_brand_on_ink"
                                    android:textSize="@dimen/ds_text_caption_size" />
                            </LinearLayout>
                        </LinearLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="84dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.classai.mobile.AvatarView
                                android:id="@+id/avatar"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:contentDescription="@string/cd_avatar" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/cardName"
                                    style="@style/ClassAI.CardText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="2"
                                    android:textSize="@dimen/ds_text_title_size" />

                                <TextView
                                    android:id="@+id/cardCode"
                                    style="@style/ClassAI.CardText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ds_space_0_5"
                                    android:alpha="0.85"
                                    android:fontFamily="monospace"
                                    android:letterSpacing="0.08"
                                    android:textSize="@dimen/ds_text_body_size" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <com.classai.mobile.WavesView
                        android:id="@+id/waves"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginBottom="-20dp"
                        android:layout_marginEnd="-20dp" />

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="bottom|end"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_contactless"
                        app:tint="@color/ds_brand_on_ink" />
                </com.classai.mobile.IdCardView>

                <TextView
                    android:id="@+id/hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nfcSettings"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:text="@string/action_nfc_settings"
                    android:visibility="gone"
                    app:icon="@drawable/ic_contactless" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_6"
                    android:text="@string/classes_title"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <TextView
                    android:id="@+id/message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_3"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/classes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
