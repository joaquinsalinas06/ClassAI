<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.classai.mobile.DriftBackgroundView
        android:id="@+id/drift"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ds_space_6"
            android:paddingVertical="@dimen/ds_space_8">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:contentDescription="@string/cd_logo"
                android:elevation="10dp"
                android:outlineProvider="background"
                android:src="@drawable/ic_logo" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_5"
                android:fontFamily="sans-serif-black"
                android:text="@string/login_title"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/ds_text_display_size" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_1"
                android:gravity="center"
                android:text="@string/login_subtitle"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@color/ds_bg_surface"
                app:cardCornerRadius="@dimen/ds_radius_xl"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_5">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/codeLayout"
                        style="@style/ClassAI.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_0"
                        android:hint="@string/field_code"
                        app:helperText="@string/field_code_helper"
                        app:counterEnabled="true"
                        app:counterMaxLength="12"
                        app:startIconContentDescription="@string/field_code"
                        app:startIconDrawable="@drawable/ic_badge">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:digits="0123456789"
                            android:fontFamily="monospace"
                            android:fontFeatureSettings="tnum"
                            android:letterSpacing="0.08"
                            android:textSize="@dimen/ds_text_title_size"
                            android:singleLine="true"
                            android:autofillHints="username"
                            android:selectAllOnFocus="false"
                            android:inputType="number"
                            android:maxLength="12" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/link"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="@dimen/ds_space_5"
                        android:text="@string/action_link"
                        android:enabled="false"
                        android:textSize="@dimen/ds_text_heading_size"
                        app:cornerRadius="@dimen/ds_radius_md"
                        app:icon="@drawable/ic_link"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_5"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:text="@string/login_privacy"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:drawableStartCompat="@drawable/ic_lock"
                app:drawableTint="?attr/colorSecondary" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
